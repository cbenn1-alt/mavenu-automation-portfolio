{
  "schema_version": "1.0.0",
  "increment": "V25",
  "source": "Mavenu_AI_SaaS_Development_Architecture_V4.pdf, page 43 (V21–V40 appendix)",
  "objective": "Add indexes and performance profiling",
  "required_proof": "Query-plan and threshold report",
  "status": "SYNTHETIC_INDEX_CANDIDATE_HUMAN_REVIEW_PENDING",
  "branch_base": "feature/reliability-intelligence-v22",
  "v24_1_migration_integrated": true,
  "sqlite_schema_version": 2,
  "approach": "Candidate indexes are installed in an isolated temporary SQLite V23/V24.1 schema-version-2 performance copy only; NOT an approved V23 production migration or V9 runtime change.",
  "policy": {
    "base_ddl": "docs/data/SCHEMA_DESIGN_V21.sql",
    "indexed_tables": [
      "maintenance_case",
      "evidence_reference"
    ],
    "temporary_db_prefix": "mavenu-v24-",
    "temporary_filename": "v24_synthetic.sqlite3",
    "tenant": "SYN-TENANT-001",
    "sites": 300,
    "assets_per_site": 6,
    "cases_per_site": 12,
    "evidence_refs_per_case": 1,
    "expected_cases": 3600,
    "expected_assets": 1800,
    "expected_evidence_rows": 3600,
    "expected_total_benchmark_rows": 9301,
    "source_fixture_set": "fully fabricated expanded benchmark, not validated V5 production data",
    "index_count": 4,
    "query_count": 4,
    "schema_version_unchanged": true,
    "fixture_sources_unmodified": true,
    "baseline_runs": 37,
    "indexed_runs": 37,
    "warmups": 5,
    "thresholds": {
      "median_ms_max": 80,
      "p95_ms_max": 200,
      "index_plan_required": true,
      "no_temp_sort_required": true,
      "baseline_result_equal_indexed": true,
      "index_install_rollback_required": true
    },
    "measurement": "Python time.perf_counter_ns, per-query individual runs, 37 measured samples plus 5 warmups; absolute thresholds are CI guardrails, NOT customer latency SLAs.",
    "no_speedup_threshold": true,
    "no_customer_data": true,
    "no_real_tenant_authorization": true,
    "no_production_index_deployment": true
  },
  "indexes": [
    {
      "name": "idx_v25_case_site_recent",
      "table": "maintenance_case",
      "columns": [
        [
          "tenant_id",
          "ASC"
        ],
        [
          "site_id",
          "ASC"
        ],
        [
          "occurred_at_utc",
          "DESC"
        ],
        [
          "case_id",
          "ASC"
        ]
      ],
      "use_case": "recent cases per fictional site"
    },
    {
      "name": "idx_v25_case_asset_recent",
      "table": "maintenance_case",
      "columns": [
        [
          "tenant_id",
          "ASC"
        ],
        [
          "site_id",
          "ASC"
        ],
        [
          "asset_id",
          "ASC"
        ],
        [
          "occurred_at_utc",
          "DESC"
        ],
        [
          "case_id",
          "ASC"
        ]
      ],
      "use_case": "recent maintenance history for one fictional asset"
    },
    {
      "name": "idx_v25_case_failure_recent",
      "table": "maintenance_case",
      "columns": [
        [
          "tenant_id",
          "ASC"
        ],
        [
          "site_id",
          "ASC"
        ],
        [
          "failure_code",
          "ASC"
        ],
        [
          "occurred_at_utc",
          "DESC"
        ],
        [
          "case_id",
          "ASC"
        ]
      ],
      "use_case": "fictional failure-code triage chronology"
    },
    {
      "name": "idx_v25_evidence_reverse",
      "table": "evidence_reference",
      "columns": [
        [
          "tenant_id",
          "ASC"
        ],
        [
          "site_id",
          "ASC"
        ],
        [
          "evidence_ref",
          "ASC"
        ],
        [
          "case_id",
          "ASC"
        ]
      ],
      "use_case": "reverse lookup of fictional evidence reference"
    }
  ],
  "queries": [
    {
      "name": "site_recent",
      "index": "idx_v25_case_site_recent",
      "rows_min": 1,
      "sql": "SELECT case_id, occurred_at_utc FROM maintenance_case WHERE tenant_id=? AND site_id=? ORDER BY occurred_at_utc DESC, case_id ASC LIMIT 10",
      "parameters": [
        "SYN-TENANT-001",
        "SYN-SITE-220"
      ]
    },
    {
      "name": "asset_recent",
      "index": "idx_v25_case_asset_recent",
      "rows_min": 1,
      "sql": "SELECT case_id, occurred_at_utc FROM maintenance_case WHERE tenant_id=? AND site_id=? AND asset_id=? ORDER BY occurred_at_utc DESC, case_id ASC LIMIT 10",
      "parameters": [
        "SYN-TENANT-001",
        "SYN-SITE-220",
        "SYN-ASSET-001"
      ]
    },
    {
      "name": "failure_recent",
      "index": "idx_v25_case_failure_recent",
      "rows_min": 1,
      "sql": "SELECT case_id, occurred_at_utc FROM maintenance_case WHERE tenant_id=? AND site_id=? AND failure_code=? ORDER BY occurred_at_utc DESC, case_id ASC LIMIT 10",
      "parameters": [
        "SYN-TENANT-001",
        "SYN-SITE-220",
        "bearing_wear"
      ]
    },
    {
      "name": "evidence_reverse",
      "index": "idx_v25_evidence_reverse",
      "rows_min": 1,
      "sql": "SELECT case_id FROM evidence_reference WHERE tenant_id=? AND site_id=? AND evidence_ref=? ORDER BY case_id ASC",
      "parameters": [
        "SYN-TENANT-001",
        "SYN-SITE-220",
        "SYN-EV-101"
      ]
    }
  ],
  "negative_cases": [
    "candidate_index_transaction_rollback_after_two_DDL",
    "reject_reapply_duplicate_indexes",
    "refuse_unexpected_index_name",
    "refuse_unexpected_index_columns",
    "reject_non_temporary_connection",
    "reject_nonversioned_schema",
    "reject_unknown_approval",
