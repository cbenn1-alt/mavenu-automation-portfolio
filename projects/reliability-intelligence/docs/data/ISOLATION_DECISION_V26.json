  "design_options": [
    {
      "key": "logical_tenant_site_scoping",
      "decision": "PROPOSED_SYNTHETIC_ONLY",
      "benefits": [
        "compatible with existing V21 composite FKs",
        "minimal prototype footprint"
      ],
      "risks": [
        "application SQL omission can expose another tenant",
        "shared administrators and schema privileges bypass guard",
        "no verified tenant authentication or database RLS"
      ]
    },
    {
      "key": "database_per_tenant",
      "decision": "UNSELECTED_OPTION",
      "benefits": [
        "stronger physical isolation boundary possible",
        "independent backup and lifecycle controls"
      ],
      "risks": [
        "operational cost",
        "migration orchestration complexity",
        "still requires authentication and controls"
      ]
    },
    {
      "key": "schema_per_tenant",
      "decision": "UNSELECTED_OPTION",
      "benefits": [
        "logical namespace separation",
        "can support differentiated schema changes"
      ],
      "risks": [
        "schema sprawl",
        "permission and routing failures",
        "not directly represented in current SQLite test schema"
      ]
    }
  ],
  "trust_boundaries": {
    "external_actor_authentication": "NOT_IMPLEMENTED",
