# Copy to .env to override defaults locally. All values are optional.
# NEVER commit real secrets — this project needs none, but the pattern stands:
# secrets arrive via environment variables, never in code or in this file.

# SQLite database file (created on first run)
MAVENU_DB_PATH=./data/mavenu.db

# HTTP port for `python run.py`
MAVENU_PORT=8080

# How long an Idempotency-Key remains valid (hours)
MAVENU_IDEMPOTENCY_TTL_HOURS=72

# Classifier confidence below this routes a lead to human review
MAVENU_REVIEW_CONFIDENCE_THRESHOLD=0.65

# Request amount (cents) above which Project 02 approval chains add finance
MAVENU_FINANCE_THRESHOLD_CENTS=100000

# Hours before a pending Project 02 approval step escalates to a director
MAVENU_APPROVAL_SLA_HOURS=48

# INFO or DEBUG
MAVENU_LOG_LEVEL=INFO
